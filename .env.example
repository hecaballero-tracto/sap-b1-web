# URL base del Service Layer de SAP Business One (sin barra final)
SAP_URL=https://sap-server:50000

# Base de datos de la compañía
SAP_COMPANY_DB=SBODemoUS

# Credenciales de usuario SAP
SAP_USER=manager
SAP_PASSWORD=TuPasswordSegura

# Puerto del servidor Express (HTTP, usado SOLO si no se configura SSL_PFX_PATH)
PORT=3000

# --- HTTPS ---
# Si SSL_PFX_PATH está definido, el servidor arranca en HTTPS y PORT se ignora.
# Ruta al archivo .pfx (relativa al proyecto o absoluta)
SSL_PFX_PATH=certs/tractoagrovial.pfx
# Clave del .pfx (passphrase). Dejar vacío si el .pfx no tiene clave.
# No incluir comillas ni espacios; el servidor los limpia automáticamente.
SSL_PFX_PASSPHRASE=TuPassphraseDelPfx
# Puerto HTTPS (por defecto 443)
HTTPS_PORT=443
# Puerto HTTP para redirección a HTTPS (opcional; dejar vacío para deshabilitar)
HTTP_PORT=80
